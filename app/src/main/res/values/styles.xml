<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 全屏沉浸：背景由 SceneView 绘制，窗口本身透明 -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg_deep</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="KeyRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:baselineAligned">false</item>
    </style>

    <style name="KeyBase">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">62dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:textSize">25sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:shadowColor">#66000000</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">4</item>
        <item name="android:background">@drawable/bg_key_num</item>
    </style>

    <style name="KeyNum" parent="KeyBase">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:background">@drawable/bg_key_num</item>
    </style>

    <style name="KeyFn" parent="KeyBase">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:background">@drawable/bg_key_fn</item>
    </style>

    <style name="KeyOp" parent="KeyBase">
        <item name="android:textColor">@color/accent_soft</item>
        <item name="android:background">@drawable/bg_key_fn</item>
    </style>

    <style name="KeyEq" parent="KeyBase">
        <item name="android:textColor">#FF06101F</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/bg_key_eq</item>
    </style>
</resources>
